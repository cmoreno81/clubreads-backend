# Copia este archivo a .env.disposable y genera una contraseña local, por ejemplo:
# openssl rand -base64 32
DISPOSABLE_DB_USER=clubreads_disposable_user
DISPOSABLE_DB_PASSWORD=
DISPOSABLE_DB_PORT=55432

# Sustituye PASSWORD_LOCAL por el mismo valor de DISPOSABLE_DB_PASSWORD.
DATABASE_URL=postgresql://clubreads_disposable_user:PASSWORD_LOCAL@127.0.0.1:55432/clubreads_disposable_test
ALLOW_DISPOSABLE_DB_WRITES=false

NODE_ENV=test
PORT=3000
TRUST_PROXY_HOPS=0
AUTH_EMAIL_MODE=capture
AUTH_CODE_CAPTURE_DIR=/tmp/clubreads-auth-codes
EXTERNAL_NOTIFICATIONS_ENABLED=false
CLOUDINARY_WRITES_ENABLED=false
COVER_BACKFILL_ENABLED=false
CRON_ENABLED=false
