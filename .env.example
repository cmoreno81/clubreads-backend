DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
GOOGLE_BOOKS_API_KEY=
NODE_ENV=development

# Logging JSON local/Railway. LOG_HASH_KEY permite correlación seudónima estable
# de IDs internos; usa un secreto aleatorio distinto de los secretos de auth.
LOG_LEVEL=info
LOG_HASH_KEY=
SLOW_REQUEST_MS=1000
PRISMA_SLOW_QUERY_MS=500

# Solo docker-compose local. Usa contraseñas aleatorias; nunca reutilices secretos reales.
POSTGRES_USER=clubreads_local
POSTGRES_PASSWORD=
POSTGRES_DB=clubreads_local
POSTGRES_PORT=5433
PGADMIN_DEFAULT_EMAIL=admin@clubreads.local
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050

# Genera valores aleatorios independientes de al menos 32 caracteres.
AUTH_ACCESS_TOKEN_SECRET=
AUTH_ACCESS_TOKEN_ISSUER=clubreads-api
AUTH_ACCESS_TOKEN_AUDIENCE=clubreads-app
AUTH_CODE_SECRET=

# Mantener en false mientras conviven la APK antigua y la nueva.
# Cambiar a true cuando todas las usuarias hayan actualizado.
AUTH_REQUIRE_ACCESS_TOKEN=false

# Health/readiness públicos, limitados por IP.
RATE_LIMIT_HEALTH_WINDOW_MS=60000
RATE_LIMIT_HEALTH_MAX=60

# Brevo: https://www.brevo.com
BREVO_API_KEY=
AUTH_EMAIL_FROM=tu-cuenta@gmail.com
AUTH_EMAIL_FROM_NAME=Club de Lectura
