DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NODE_ENV=development

# Genera valores aleatorios independientes de al menos 32 caracteres.
AUTH_ACCESS_TOKEN_SECRET=
AUTH_CODE_SECRET=

# Mantener en false mientras conviven la APK antigua y la nueva.
# Cambiar a true cuando todas las usuarias hayan actualizado.
AUTH_REQUIRE_ACCESS_TOKEN=false

# Brevo: https://www.brevo.com
BREVO_API_KEY=
AUTH_EMAIL_FROM=tu-cuenta@gmail.com
AUTH_EMAIL_FROM_NAME=Club de Lectura
