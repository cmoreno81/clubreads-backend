// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum ReadingStatus {
  PENDING
  READING
  PAUSED
  FINISHED
  ABANDONED
  REREADING
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum ReadingFormat {
  PHYSICAL
  DIGITAL
  AUDIOBOOK
}

enum HistoryEvent {
  STATUS_CHANGED
  PRIORITY_CHANGED
  RATING_CHANGED
  REVIEW_UPDATED
}

enum ReadingType {
  FREE
  CLUBVISION
}

enum ReactionType {
  LIKE
  AGREE
  ANGRY
  FUNNY
  THUMBS_UP
  CRY
  WOW
  SWEAR
  CLAP
}

enum ClubMood {
  HOOKED
  SHOCKED
  CRYING
  ANGRY
  LAUGHING
  BLOCKED
}

enum ReadingSessionStatus {
  ACTIVE
  FINISHED
}

enum ClubVisibility {
  PRIVATE
  PUBLIC
}

enum ClubType {
  SOCIAL // club normal con varios miembros
  PERSONAL // espacio lector individual (sin funciones sociales)
}

enum ClubRole {
  OWNER
  ADMIN
  MEMBER
}

enum BookOfYearDuelPhase {
  MONTH_PAIR
  SEMIFINAL
}

enum ClubBookOfYearStatus {
  PREPARING
  QUALIFYING
  ROUND_PENDING
  ROUND_OPEN
  TIEBREAK
  FINISHED
  CANCELLED
}

enum ClubBookOfYearPhase {
  QUALIFYING
  QUARTERFINAL
  SEMIFINAL
  FINAL
  TIEBREAK
}

enum ClubBookOfYearRoundStatus {
  PENDING
  OPEN
  CLOSED
}

enum AuthCodePurpose {
  ACTIVATE
  REGISTER
  RESET_PASSWORD
}

enum HiddenUserSeriesType {
  OCULTA
  ELIMINADA
}

//
// AUTHOR
//

model Author {
  id String @id @default(cuid())

  name String @unique

  biography String?

  photoUrl String?

  goodreadsUrl String?

  website String?

  books Book[]

  series Series[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?
}

//
// GENRE
//

model Genre {
  id String @id @default(cuid())

  name String @unique

  icon String?

  color String?

  books Book[]

  series Series[]
}

//
// SERIES
//

model Series {
  id String @id @default(cuid())

  name String @unique

  authorId String?

  author Author? @relation(fields: [authorId], references: [id])

  genreId String?

  genre Genre? @relation(fields: [genreId], references: [id])

  totalBooks Int?

  publicationStatus SeriesPublicationStatus @default(UNKNOWN)

  books      Book[]
  overrides  SeriesBookOverride[]
  hiddenBy   HiddenUserSeries[]
  userOrders UserSeriesOrder[]
}

enum SeriesPublicationStatus {
  UNKNOWN
  ONGOING
  COMPLETED
}

//
// BOOK
//

model Book {
  id String @id @default(cuid())

  title String

  originalTitle String?

  subtitle String?

  authorId String?
  author   Author? @relation(fields: [authorId], references: [id])

  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id])

  seriesId String?
  series   Series? @relation(fields: [seriesId], references: [id])

  seriesOrder String?

  standalone Boolean @default(true)

  isbn String?

  normalizedIsbn String?

  canonicalKey String?

  publicationYear Int?

  totalPages Int?

  goodreadsUrl String?

  coverUrl String?

  synopsis String?

  createdById String?
  createdBy   User?   @relation("CreatedBooks", fields: [createdById], references: [id])

  library            Library[]
  readingCompletions ReadingCompletion[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt                   DateTime?
  readings                    Reading[]
  reviews                     Review[]
  wonClubvisions              Clubvision[]
  clubvisionCandidates        ClubvisionCandidate[]
  clubvisionResults           ClubvisionResult[]           @relation("ClubvisionWinner")
  redirectsFrom               BookRedirect[]               @relation("CanonicalBookRedirect")
  userSeriesOrders            UserSeriesOrder[]
  bookOfYearMonthlySelections BookOfYearMonthlySelection[]
  bookOfYearDuelWinners       BookOfYearDuelWinner[]
  bookOfYearFinalists         BookOfYearFinalist[]
  bookOfYearWinners           BookOfYearWinner[]
  clubBookOfYearCandidates    ClubBookOfYearCandidate[]
  clubBookOfYearHistoricalLinks ClubBookOfYearHistoricalLink[]

  @@index([title])
  @@index([authorId])
  @@index([genreId])
  @@index([seriesId])
  @@index([canonicalKey])
  @@index([normalizedIsbn])
}

model BookRedirect {
  oldBookId       String   @id
  canonicalBookId String
  canonicalBook   Book     @relation("CanonicalBookRedirect", fields: [canonicalBookId], references: [id], onDelete: Restrict)
  reason          String?
  createdAt       DateTime @default(now())

  @@index([canonicalBookId])
}

model BookMergeAudit {
  id              String   @id @default(cuid())
  sourceBookId    String
  canonicalBookId String
  snapshot        Json
  createdAt       DateTime @default(now())

  @@index([sourceBookId])
  @@index([canonicalBookId])
}

//
// USER
//

model User {
  id String @id @default(cuid())

  name  String @unique
  email String @unique

  avatarUrl String?

  passwordHash        String?
  passwordSetAt       DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdBooks       Book[]              @relation("CreatedBooks")
  library            Library[]
  readingCompletions ReadingCompletion[]
  comments           Comment[]
  reviews            Review[]
  likes              Like[]
  progressReactions  ProgressReaction[]

  conversationReads ConversationRead[]

  ownedClubs         Club[]               @relation("OwnedClubs")
  clubMemberships    ClubMember[]
  notifications      Notification[]
  seriesOverrides    SeriesBookOverride[]
  hiddenSeries       HiddenUserSeries[]
  importRowReceipts  ImportRowReceipt[]
  achievementUnlocks AchievementUnlock[]

  activeClubId String?

  activeClub Club? @relation("ActiveClub", fields: [activeClubId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubvisionVotes               ClubvisionVote[]
  moodVotes                     ClubMoodVote[]
  authCodes                     AuthCode[]
  authSessions                  AuthSession[]
  seriesOrders                  UserSeriesOrder[]
  readingChallenges             ReadingChallenge[]
  dailyCheckins                 DailyCheckin[]
  readingSessions               ReadingSession[]
  bookOfYearMonthlySelections   BookOfYearMonthlySelection[]
  bookOfYearDuelWinners         BookOfYearDuelWinner[]
  bookOfYearFinalists           BookOfYearFinalist[]
  bookOfYearWinners             BookOfYearWinner[]
  clubBookOfYearQualifyingVotes ClubBookOfYearQualifyingVote[]
  clubBookOfYearDuelVotes       ClubBookOfYearDuelVote[]

  @@index([activeClubId])
}

model HiddenUserSeries {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  tipo HiddenUserSeriesType @default(OCULTA) // ← nuevo

  createdAt DateTime @default(now())

  @@unique([userId, seriesId])
  @@index([userId])
  @@index([seriesId])
}

enum ImportSource {
  GOODREADS
  BOOKMORY
}

model ImportRowReceipt {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  source         ImportSource
  idempotencyKey String
  sourceRowId    String?
  bookId         String
  createdAt      DateTime     @default(now())

  @@unique([userId, source, idempotencyKey])
  @@index([bookId])
}

model AuthCode {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose  AuthCodePurpose
  codeHash String
  attempts Int             @default(0)

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model AuthSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

//
// CLUB
//

model Club {
  id String @id @default(cuid())

  name String

  slug String @unique

  description String?

  avatarUrl String?

  tipo ClubType @default(SOCIAL)

  visibility ClubVisibility @default(PRIVATE)

  inviteCode String? @unique

  ownerId String
  owner   User   @relation("OwnedClubs", fields: [ownerId], references: [id])

  members ClubMember[]

  activeUsers User[] @relation("ActiveClub")

  readings           Reading[]
  clubvisions        Clubvision[]
  clubvisionResults  ClubvisionResult[]
  moodVotes          ClubMoodVote[]
  bookOfYearEditions ClubBookOfYearEdition[]
  bookOfYearHistoricalLinks ClubBookOfYearHistoricalLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([visibility])
}

//
// CLUB MEMBER
//

model ClubMember {
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role ClubRole @default(MEMBER)

  joinedAt DateTime @default(now())

  @@id([clubId, userId])
  @@index([userId])
  @@index([clubId, role])
}

model ClubMoodVote {
  id String @id @default(cuid())

  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekKey String
  mood    ClubMood

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, userId, weekKey])
  @@index([clubId, weekKey])
  @@index([weekKey])
}

model Like {
  id String @id @default(cuid())

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  reaction ReactionType @default(LIKE)

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

//
// LIBRARY
//

model Library {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  bookId String
  book   Book   @relation(fields: [bookId], references: [id])

  status ReadingStatus

  priority      Priority       @default(MEDIUM)
  readingFormat ReadingFormat?

  startedAt DateTime?

  pausedAt DateTime?

  pauseReason String? @db.Text

  finishedAt DateTime?

  isFavorite Boolean @default(false)

  lastProgress Int?
  currentPage  Int?

  progressNote      String?            @db.Text
  progressUpdatedAt DateTime?
  progressReactions ProgressReaction[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
  @@index([status])
  @@index([userId, status])
  @@index([userId, bookId])
  @@index([bookId, status])
}

model ProgressReaction {
  id String @id @default(cuid())

  libraryId String
  library   Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reaction ReactionType @default(LIKE)

  createdAt DateTime @default(now())

  @@unique([libraryId, userId])
  @@index([userId])
}

model ReadingCompletion {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  startedAt     DateTime?
  finishedAt    DateTime
  isReread      Boolean        @default(false)
  rating        Float?
  review        String?        @db.Text
  readingFormat ReadingFormat?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, finishedAt])
  @@index([userId, isReread, finishedAt])
  @@index([bookId, finishedAt])
  @@index([isReread, finishedAt])
}

model BookOfYearMonthlySelection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year, month])
  @@index([userId, year])
  @@index([bookId])
}

model BookOfYearDuelWinner {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  phase     BookOfYearDuelPhase
  position  Int
  bookId    String
  book      Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)
  automatic Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, year, phase, position])
  @@index([userId, year, phase])
  @@index([bookId])
}

model BookOfYearFinalist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  position  Int
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year, position])
  @@index([userId, year])
  @@index([bookId])
}

model BookOfYearWinner {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
  @@index([bookId])
}

model ClubBookOfYearEdition {
  id                String                         @id @default(cuid())
  clubId            String
  club              Club                           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  year              Int
  status            ClubBookOfYearStatus           @default(PREPARING)
  bracketSize       Int?
  winnerCandidateId String?
  winnerCandidate   ClubBookOfYearCandidate?       @relation("ClubBookOfYearWinner", fields: [winnerCandidateId], references: [id], onDelete: SetNull)
  startedAt         DateTime?
  finishedAt        DateTime?
  candidatesSyncedAt DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  candidates        ClubBookOfYearCandidate[]      @relation("ClubBookOfYearCandidates")
  rounds            ClubBookOfYearRound[]
  qualifyingVotes   ClubBookOfYearQualifyingVote[]

  @@unique([clubId, year])
  @@index([clubId, status])
  @@index([year])
}

model ClubBookOfYearCandidate {
  id                 String                         @id @default(cuid())
  editionId          String
  edition            ClubBookOfYearEdition          @relation("ClubBookOfYearCandidates", fields: [editionId], references: [id], onDelete: Cascade)
  bookId             String
  book               Book                           @relation(fields: [bookId], references: [id], onDelete: Restrict)
  seed               Int?
  qualified          Boolean                        @default(false)
  tiebreakEligible   Boolean                        @default(false)
  titleSnapshot      String
  coverUrlSnapshot   String?
  authorNameSnapshot String?
  source             String                         @default("OFFICIAL_READING")
  clubvisionEdition  String?
  needsReview        Boolean                        @default(false)
  createdAt          DateTime                       @default(now())
  winnerOf           ClubBookOfYearEdition[]        @relation("ClubBookOfYearWinner")
  duelAsA            ClubBookOfYearDuel[]           @relation("ClubBookOfYearDuelA")
  duelAsB            ClubBookOfYearDuel[]           @relation("ClubBookOfYearDuelB")
  wonDuels           ClubBookOfYearDuel[]           @relation("ClubBookOfYearDuelWinner")
  qualifyingVotes    ClubBookOfYearQualifyingVote[]
  duelVotes          ClubBookOfYearDuelVote[]

  @@unique([editionId, bookId])
  @@unique([id, editionId])
  @@index([bookId])
  @@index([editionId, seed])
}

model ClubBookOfYearHistoricalLink {
  id       String @id @default(cuid())
  clubId   String
  club     Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  year     Int
  resultId String @unique
  result   ClubvisionResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  bookId   String
  book     Book @relation(fields: [bookId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId, year])
  @@index([bookId])
}

model ClubBookOfYearRound {
  id        String                    @id @default(cuid())
  editionId String
  edition   ClubBookOfYearEdition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  phase     ClubBookOfYearPhase
  sequence  Int
  status    ClubBookOfYearRoundStatus @default(PENDING)
  openedAt  DateTime?
  closedAt  DateTime?
  createdAt DateTime                  @default(now())
  duels     ClubBookOfYearDuel[]

  @@unique([editionId, sequence])
  @@index([editionId, phase, status])
}

model ClubBookOfYearDuel {
  id                String                   @id @default(cuid())
  roundId           String
  round             ClubBookOfYearRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  position          Int
  candidateAId      String
  candidateA        ClubBookOfYearCandidate  @relation("ClubBookOfYearDuelA", fields: [candidateAId], references: [id], onDelete: Restrict)
  candidateBId      String
  candidateB        ClubBookOfYearCandidate  @relation("ClubBookOfYearDuelB", fields: [candidateBId], references: [id], onDelete: Restrict)
  winnerCandidateId String?
  winnerCandidate   ClubBookOfYearCandidate? @relation("ClubBookOfYearDuelWinner", fields: [winnerCandidateId], references: [id], onDelete: SetNull)
  tied              Boolean                  @default(false)
  votes             ClubBookOfYearDuelVote[]

  @@unique([roundId, position])
  @@index([roundId])
}

model ClubBookOfYearQualifyingVote {
  id          String                  @id @default(cuid())
  editionId   String
  edition     ClubBookOfYearEdition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   ClubBookOfYearCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt   DateTime                @default(now())

  @@unique([editionId, userId, candidateId])
  @@index([editionId, candidateId])
  @@index([userId])
}

model ClubBookOfYearDuelVote {
  id          String                  @id @default(cuid())
  duelId      String
  duel        ClubBookOfYearDuel      @relation(fields: [duelId], references: [id], onDelete: Cascade)
  userId      String
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   ClubBookOfYearCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([duelId, userId])
  @@index([duelId, candidateId])
  @@index([userId])
}

//
// READING
//

model Reading {
  id String @id @default(cuid())

  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id])

  type ReadingType

  status ReadingSessionStatus

  chapters Int

  hasPrologue Boolean @default(false)

  hasEpilogue Boolean @default(false)

  startedAt DateTime @default(now())

  finishedAt DateTime?

  conversations Conversation[]

  @@index([clubId, status])
  @@index([clubId, bookId, status])
  @@index([clubId, type, status])
}

model Conversation {
  id String @id @default(cuid())

  readingId String
  reading   Reading @relation(fields: [readingId], references: [id], onDelete: Cascade)

  title String

  order Int

  spoiler Boolean @default(false)

  comments Comment[]

  reads ConversationRead[]

  @@index([readingId])
}

model ConversationRead {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  lastSeenAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
  @@index([lastSeenAt])
}

//
// COMMENT
//

model Comment {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  text  String  @db.Text
  type  String  @default("COMMENT")
  color String?

  parentId String?
  parent   Comment?  @relation("CommentTree", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentTree")

  edited    Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  likes     Like[]

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([userId])
  @@index([parentId])
}

//
// REVIEW
//

model Review {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  bookId String
  book   Book   @relation(fields: [bookId], references: [id])

  rating Float

  review String? @db.Text

  containsSpoilers Boolean @default(false)

  edited Boolean @default(false)

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
}

enum ClubvisionStatus {
  SIN_DATOS
  VOTACION
  RESULTADOS
  LECTURA
  FINALIZADA
}

model Clubvision {
  id String @id @default(cuid())

  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  edition String // yyyy-MM

  status ClubvisionStatus @default(SIN_DATOS)

  title   String?
  message String?

  openedAt   DateTime?
  closedAt   DateTime?
  finishedAt DateTime?

  winnerBookId String?
  winnerBook   Book?   @relation(fields: [winnerBookId], references: [id])

  candidates ClubvisionCandidate[]
  votes      ClubvisionVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, edition])
  @@index([clubId, status])
}

model ClubvisionCandidate {
  id String @id @default(cuid())

  clubvisionId String
  clubvision   Clubvision @relation(fields: [clubvisionId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id])

  order Int?

  createdAt       DateTime         @default(now())
  clubvisionVotes ClubvisionVote[]

  @@unique([clubvisionId, bookId])
  @@unique([id, clubvisionId])
  @@index([clubvisionId])
  @@index([bookId])
}

model ClubvisionVote {
  id String @id @default(cuid())

  clubvisionId String
  clubvision   Clubvision @relation(fields: [clubvisionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  candidateId String
  candidate   ClubvisionCandidate @relation(fields: [candidateId, clubvisionId], references: [id, clubvisionId], onDelete: Cascade)

  position Int
  points   Int

  createdAt DateTime @default(now())

  @@unique([clubvisionId, userId, candidateId])
  @@unique([clubvisionId, userId, position])
  @@index([clubvisionId])
  @@index([userId])
}

model ClubvisionResult {
  id String @id @default(cuid())

  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  edition String // yyyy-MM

  winnerBookId String?
  winnerBook   Book?   @relation("ClubvisionWinner", fields: [winnerBookId], references: [id])

  winnerTitle String
  points      Int

  secondTitle String?
  thirdTitle  String?

  createdAt DateTime @default(now())
  bookOfYearHistoricalLink ClubBookOfYearHistoricalLink?

  @@unique([clubId, edition])
  @@index([edition])
}

// ─────────────────────────────────────────────
// NOTIFICACIONES IN-APP
// ─────────────────────────────────────────────

model AchievementUnlock {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

enum NotificationType {
  CLUBVISION_ABIERTA
  CLUBVISION_RESULTADOS
  LECTURA_NUEVA
  COMENTARIO_LECTURA
  LIBRO_TERMINADO
  LIBRO_EMPEZADO
  LIBRO_NUEVO_BIBLIOTECA
  NUEVA_MIEMBRO
  LOGRO_DESBLOQUEADO
  CLUB_BOOK_OF_YEAR
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tipo    NotificationType
  titulo  String
  mensaje String

  leida Boolean @default(false)

  // Referencias opcionales para navegación
  clubId String?
  bookId String?
  extra  String? // JSON con datos adicionales

  createdAt DateTime @default(now())

  @@index([userId, leida])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────
// SAGAS: tomos leídos fuera de ClubReads u omitidos
// ─────────────────────────────────────────────

enum SeriesBookOverrideType {
  LEIDO_EXTERNO // Lo he leído pero no está en ClubReads
  OMITIDO // No quiero leerlo (subsagas, spin-offs)
}

model SeriesBookOverride {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  // Posición del tomo en la saga (1, 2, 3...)
  posicion Int

  tipo SeriesBookOverrideType

  createdAt DateTime @default(now())

  @@unique([userId, seriesId, posicion])
  @@index([userId, seriesId])
}

// prisma/schema.prisma — añadir al final, antes del último }

model UserSeriesOrder {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  // Posición visual que el usuario quiere para este libro en esta saga
  posicion Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, seriesId, bookId])
  @@unique([userId, seriesId, posicion])
  @@index([userId, seriesId])
}

model ReadingChallenge {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  year   Int
  target Int // objetivo de libros

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year])
  @@index([year])
}

/// Check-in diario de lectura.
/// Un registro por usuario y día — idempotente (upsert).
model DailyCheckin {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Fecha en formato YYYY-MM-DD (zona local del servidor, UTC).
  date String // "2026-08-13"

  /// Nota opcional del check-in ("Hoy terminé el capítulo 12…").
  note String? @db.Text

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

/// Sesión de lectura diaria — acumula páginas leídas ese día.
/// Se crea/actualiza cada vez que el usuario actualiza su progreso en un libro.
/// Permite calcular la intensidad del mapa de calor basada en páginas reales.
model ReadingSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Fecha en formato YYYY-MM-DD (UTC).
  date String

  /// Total de páginas leídas ese día (suma de todos los libros).
  pagesRead Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}
